{
  "name": "faceverify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Realistic 3D digital-twin head PWA — photo-to-avatar and live camera driven face tracking.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "assets": "node scripts/fetch-assets.mjs",
    "env": "node scripts/gen-studio-env.mjs",
    "predev": "npm run assets && npm run env && npm run icons",
    "prebuild": "npm run assets && npm run env && npm run icons",
    "test": "node --test scripts/*.test.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
