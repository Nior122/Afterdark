# Copy to .env.local for local development (`npm run dev`).
#
# Public origin of the site, no trailing slash. Used for canonical URLs,
# Open Graph tags, sitemap.xml and robots.txt. Set this to the real domain
# wherever the site is built (Cloudflare Pages / GitHub Actions variable).
# VITE_SITE_URL=http://localhost:5173

# Optional: base URL of the Telegram bot Worker (see docs/telegram-bot-setup.md).
# When set at build time, videos published through the bot are playable at
# /v/<id>/ and are prerendered + listed in sitemap.xml during the build.
# This is a public URL (it ships in the site's JS), not a secret.
# VITE_TELEGRAM_FEED_URL=https://afterdark-bot.yourname.workers.dev
